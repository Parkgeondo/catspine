# 프로덕션에서는 반드시 길고 무작위한 값으로 설정하세요.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCORE_SECRET=

# 포트 (기본 3000)
PORT=3000

# 리버스 프록시(nginx 등) 뒤에서 실행할 때만 1로 설정 (실제 클라이언트 IP 인식용)
# TRUST_PROXY=1

# 프로덕션 모드 (SCORE_SECRET 미설정 시 서버가 시작을 거부)
# NODE_ENV=production

# 랭킹 API 호출을 허용할 교차 오리진 목록 (쉼표 구분).
# GitHub Pages·토스 미니앱 웹뷰 등 다른 도메인에서 서버를 쓸 때 설정.
# 미설정 시 same-origin만 허용. 차단된 오리진은 서버 로그에 찍힘.
# ALLOWED_ORIGINS=https://parkgeondo.github.io,https://<toss-webview-origin>
